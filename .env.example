app_model_name=Qualcomm-AI-Research/BamiBERT
app_checkpoint_path=models/best_model.pt
app_max_length=512
app_device=cpu
app_ig_n_steps=25
app_cors_origins=http://localhost:5173,http://localhost:3000
app_gemini_api_key=your_gemini_api_key_here
app_gemini_model=gemini-2.5-flash
app_gemini_rate_limit_per_minute=10
app_jwt_secret_key=your_jwt_secret_key_here
app_jwt_algorithm=HS256
app_jwt_expire_minutes=1440
app_database_url=sqlite:///./backend/database/app.db
app_avatar_upload_dir=backend/uploads/avatars