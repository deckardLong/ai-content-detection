\subsection{Classification Models}
\todo{Introduce the two heads, then explain the equations below.}

\textbf{CNN.}
\begin{equation}
  c^{(k,j)}_i = \mathrm{ReLU}\!\left(\mathbf{w}^{(k,j)} \cdot \mathbf{H}_{i:i+k-1} + b^{(k,j)}\right).
\end{equation}
\begin{equation}
  \hat{c}^{(k,j)} = \max_{i} \; m_{i+k-1}\, c^{(k,j)}_i .
\end{equation}
\todo{Explain the CNN head; the concatenated vector is $\mathbf{z} \in \mathbb{R}^{3F} = \mathbb{R}^{384}$.}

\textbf{BiLSTM.}
\begin{equation}
  \mathbf{z} = [\,\overrightarrow{\mathbf{h}}_T \,;\, \overleftarrow{\mathbf{h}}_1\,] \in \mathbb{R}^{2h}.
\end{equation}
\todo{Explain the BiLSTM head.}

\textbf{CNN\,$\|$\,BiLSTM (extension).}
\begin{equation}
  \mathbf{z} = [\mathbf{z}_{\mathrm{CNN}} ; \mathbf{z}_{\mathrm{BiLSTM}}] \in \mathbb{R}^{640}.
\end{equation}
\todo{Explain the extension head (optional, remove if not needed).}

\textbf{Output layer and loss.}
\begin{equation}
  \hat{\mathbf{y}} = \mathrm{softmax}\!\left(\mathbf{W}\,\mathrm{Dropout}(\mathbf{z}) + \mathbf{b}\right) \in \mathbb{R}^{2}.
\end{equation}
\begin{equation}
  \mathcal{L} = -\frac{1}{N}\sum_{n=1}^{N}\sum_{c\in\{0,1\}} y_{n,c}\,\log \hat{y}_{n,c}.
\end{equation}
