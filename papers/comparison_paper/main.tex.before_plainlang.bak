    \draw[arr] (out.west) -- (ev.east);
  \end{tikzpicture}}
  \caption{Tổng quan phương pháp. Bộ dữ liệu gồm bài báo do người viết (Human), bài do LLM sinh theo chủ đề (AI-Generated) và bài người viết được LLM viết lại (AI-Rewritten). Văn bản được làm sạch, cắt về 225 âm tiết đầu, đi qua tokenizer riêng của từng encoder (PhoBERT cần tách từ trước, BamiBERT nhận văn bản thô), rồi vào encoder đóng băng (PhoBERT hoặc BamiBERT); chỉ head (CNN hoặc BiLSTM) được huấn luyện. Ghép mỗi encoder với mỗi head tạo thành bốn mô hình được so sánh.}
  \label{fig:overview}
\end{figure*}

\subsection{Tổng quan}
Hình~\ref{fig:overview} mô tả quy trình tổng thể. Phạm vi nghiên cứu là phân loại một văn bản tiếng Việt do người viết hay có sự tham gia của LLM. Bốn mô hình được so sánh là tổ hợp của hai encoder (PhoBERT, BamiBERT) và hai mô hình phân loại (CNN, BiLSTM). Các yếu tố còn lại gồm dữ liệu, cách chia tập, nội dung đầu vào, seed, bộ tối ưu và số epoch đều được giữ giống nhau, để khác biệt về kết quả chỉ đến từ encoder và mô hình phân loại.

\subsection{Thu thập dữ liệu}
Dữ liệu là các bài báo thuộc lĩnh vực công nghệ thông tin và thiết bị điện tử, thu thập từ sáu trang tin tiếng Việt: ICTnews (VietNamNet), Quản Trị Mạng, Thanh Niên, VnExpress, GenK và Tuổi Trẻ. Bộ dữ liệu có ba loại văn bản:
\begin{itemize}
  \item \textbf{Human}: bài báo gốc do người viết.
  \item \textbf{AI-Generated}: bài báo do LLM sinh ra từ đầu, với câu lệnh (prompt) có chủ đề và yêu cầu văn phong giống người viết.
  \item \textbf{AI-Rewritten}: bài báo gốc của người được LLM viết lại.
\end{itemize}
Văn bản AI được sinh và viết lại bằng hai LLM là Gemini (Google) và DeepSeek, sử dụng phiên bản miễn phí qua giao diện trò chuyện, vì phiên bản miễn phí có thể được nhà cung cấp thay đổi theo thời gian, tôi không xác định được chính xác phiên bản model tại thời điểm sinh dữ liệu. Hai loại AI được gán nhãn 1, loại Human được gán nhãn 0. Bộ dữ liệu cân bằng giữa hai lớp với 2\,500 bài người viết, 1\,250 bài AI sinh ra và 1\,250 bài AI viết lại (Bảng~\ref{tab:dataset}).

Trong 2\,500 bài người viết, 2\,270 bài (90.8\%) xuất bản năm 2026, số còn lại rải rác từ 2010 đến 2025.

